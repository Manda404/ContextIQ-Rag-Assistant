# Optionnel : dossier contenant knowledge_base.json et eval_set.json.
# Exporter cette variable dans le terminal ou la définir avant DataLoader().
# Le fichier .env n'est pas chargé automatiquement.
# CONTEXTIQ_DATA_DIR=./data/raw

# Optionnel : cache des poids du modèle d'embeddings.
# SENTENCE_TRANSFORMERS_HOME=./model-cache
# Ajouter tout cache local au .gitignore ; ne pas versionner les poids.

# Optionnel : dossier contenant retrieval.yaml, evaluation.yaml et logging.yaml.
# CONTEXTIQ_CONFIG_DIR=./configs

# Optionnel : journalisation locale (variables à exporter avant configuration).
# CONTEXTIQ_LOG_DIR=logs
# CONTEXTIQ_LOG_LEVEL=INFO

# Surcharge optionnelle de console dans configs/logging.yaml (false par défaut).
# CONTEXTIQ_LOG_CONSOLE=0
